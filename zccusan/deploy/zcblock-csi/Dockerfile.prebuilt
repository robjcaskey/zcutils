FROM docker.io/library/debian:trixie-slim AS runtime-tools

RUN apt-get update && apt-get install -y --no-install-recommends \
    e2fsprogs \
    libfabric1 \
    util-linux \
    xfsprogs \
    && rm -rf /var/lib/apt/lists/*

COPY target/release/zcblock-csi /runtime-root/usr/local/bin/zcblock-csi
COPY target/release/zcutils /runtime-root/usr/local/bin/zcutils
COPY target/release/zcblock-control /runtime-root/usr/local/bin/zcblock-control
COPY target/release/zccusan-operator /runtime-root/usr/local/bin/zccusan-operator
COPY target/release/zcblock-freeze /runtime-root/usr/local/bin/zcblock-freeze
COPY target/release/zcrepl /runtime-root/usr/local/bin/zcrepl
COPY target/release/zcpit /runtime-root/usr/local/bin/zcpit
COPY target/release/zctier /runtime-root/usr/local/bin/zctier
COPY target/release/zcnblk-fan /runtime-root/usr/local/bin/zcnblk-fan
COPY target/release/zcnblk-shm-target /runtime-root/usr/local/bin/zcnblk-shm-target
COPY target/release/zcnblk-wal-failover /runtime-root/usr/local/bin/zcnblk-wal-failover
COPY target/release/zcnblk-wal-leaf /runtime-root/usr/local/bin/zcnblk-wal-leaf
COPY zccusan/deploy/zcblock-csi/allowed-raw-partitions.empty.txt /runtime-root/etc/zcblock-csi/allowed-raw-partitions.txt

RUN set -eux; \
    bins="/runtime-root/usr/local/bin/zcutils /runtime-root/usr/local/bin/zcblock-csi /runtime-root/usr/local/bin/zcblock-control /runtime-root/usr/local/bin/zccusan-operator /runtime-root/usr/local/bin/zcblock-freeze /runtime-root/usr/local/bin/zcrepl /runtime-root/usr/local/bin/zcpit /runtime-root/usr/local/bin/zctier /runtime-root/usr/local/bin/zcnblk-fan /runtime-root/usr/local/bin/zcnblk-shm-target /runtime-root/usr/local/bin/zcnblk-wal-failover /runtime-root/usr/local/bin/zcnblk-wal-leaf /usr/bin/mount /usr/bin/umount /usr/bin/findmnt /usr/sbin/blkid /usr/sbin/losetup /usr/sbin/mkfs.ext4 /usr/sbin/mkfs.xfs /usr/sbin/fsfreeze"; \
    for bin in /usr/bin/mount /usr/bin/umount /usr/bin/findmnt /usr/sbin/blkid /usr/sbin/losetup /usr/sbin/mkfs.ext4 /usr/sbin/mkfs.xfs /usr/sbin/fsfreeze; do \
      mkdir -p "/runtime-root$(dirname "$bin")"; \
      cp "$bin" "/runtime-root$bin"; \
    done; \
    for bin in $bins; do \
      ldd "$bin" | awk '/=> \// {print $3} /^\// {print $1}'; \
    done | sort -u | while read -r lib; do \
      mkdir -p "/runtime-root$(dirname "$lib")"; \
      if [ -e "$lib" ]; then \
        cp -L "$lib" "/runtime-root$lib"; \
      fi; \
    done; \
    for loader in /lib/ld-linux-*.so.* /lib64/ld-linux-*.so.*; do \
      if [ -e "$loader" ]; then \
        mkdir -p "/runtime-root$(dirname "$loader")"; \
        cp -L "$loader" "/runtime-root$loader"; \
      fi; \
    done; \
    if [ -e /etc/mke2fs.conf ]; then \
      mkdir -p /runtime-root/etc; \
      cp /etc/mke2fs.conf /runtime-root/etc/mke2fs.conf; \
    fi

FROM gcr.io/distroless/cc-debian13

COPY --from=runtime-tools /runtime-root/ /

ENV PATH="/usr/local/bin:/usr/sbin:/usr/bin"
USER 0:0
ENTRYPOINT ["/usr/local/bin/zcblock-csi"]
